{
  "$schema": "https://schemas.tauri.app/schema/capability/v1",
  "identifier": "default",
  "description": "Default permissions for Osmanthus",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:scope-home-recursive",
    "opener:default",
    "opener:allow-open-url",
    "store:default",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save"
  ]
}
